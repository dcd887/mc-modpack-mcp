# mc-modpack-mcp Environment Variables

# AI 诊断功能（可选）
# 设置通义千问 API Key 以启用 ai_diagnose 工具
# 获取方式：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-api-key-here

# 可选：自定义 DashScope  endpoint（默认使用北京节点）
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# 合规开关：禁用 Modrinth API 调用（默认关闭）
# 设置为 true 后，替换推荐仅从本地 rules.json 读取，不联网查询
DISABLE_MODRINTH=false
