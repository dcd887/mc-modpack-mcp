{
  "name": "mc-modpack-mcp",
  "version": "1.0.0",
  "description": "MCP server for Minecraft modpack diagnostics. Supports Fabric/Forge mod conflicts, dependency checks, crash analysis, and log parsing.",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "mc-modpack-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "node test.js"
  },
  "keywords": [
    "minecraft",
    "modpack",
    "mcp",
    "model-context-protocol",
    "fabric",
    "forge",
    "pcl",
    "diagnostics"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
